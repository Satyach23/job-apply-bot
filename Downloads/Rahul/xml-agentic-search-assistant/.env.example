# ===========================================
# ACP Document Analyzer — Environment Config
# ===========================================

# --- LLM (use one of the following) ---
# Option A: LexisNexis AI Gateway (LiteLLM proxy, often requires VPN)
# AI_GATEWAY_ENDPOINT=https://cert-proxy-core.rag-us.use1.dev-searchplatform.n1.lexis.com/
# AI_GATEWAY_TENANT_KEY=your_tenant_api_key

# Option B: Direct Google Gemini (fallback / local dev)
GOOGLE_API_KEY=your_google_api_key_here

# --- Vector store (embeddings) ---
# sqlite = SQLite document_embeddings table (default, no extra deps)
# chroma = ChromaDB under data/chroma (pip install chromadb)
# faiss  = FAISS index under data/faiss (pip install faiss-cpu)
VECTOR_BACKEND=sqlite
