FROM python:3.11-slim
WORKDIR /app
COPY lt_common /app/lt_common
COPY tracker_center_svc /app/tracker_center_svc
RUN pip install --no-cache-dir fastapi uvicorn pydantic pydantic-settings sqlalchemy aiosqlite
ENV PYTHONPATH=/app
CMD ["uvicorn", "tracker_center_svc.main:app", "--host", "0.0.0.0", "--port", "8002"]
